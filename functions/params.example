# Copy to functions/.env.bentominder (git-ignored) before deploying. Names and defaults only; secrets are set with
# `firebase functions:secrets:set GEMINI_API_KEY` and `ALLOWED_ACCOUNTS` and never live in files (ADR 015).
# Comma-separated. https://localhost is the page origin of the Android app (Capacitor androidScheme https, docs/dev/android-build.md);
# add it only when the Android build uses the hosted endpoints. Redeploy the functions after changing it.
ALLOWED_ORIGINS=https://mrdrah.github.io,https://localhost
EXTRACT_PER_HOUR=5
EXTRACT_PER_DAY=20
FETCH_PER_HOUR=30
FETCH_PER_DAY=100
# Family sync (ADR 016 section 8). The allow-list secret ALLOWED_ACCOUNTS is shared with the proxy.
MAX_MEMBERS=2
INVITE_TTL_HOURS=72
INVITE_FAILED_PER_HOUR=10
SYNC_WRITES_PER_HOUR=600
CLOUD_NOTICE_MIN_VERSION=1
