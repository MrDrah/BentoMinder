  "steps": [
    {
      "ja": "大葉は軸を落として、細いせん切りにする。",
      "en": "Trim the stem off the shiso leaf and shred it finely."
    },
    {
      "ja": "ソーセージを輪切りにし、表面に格子の切り込みを入れる。",
      "en": "Slice the sausage into rounds and score a criss-cross pattern on the surface."
    },
    {
      "ja": "ごはんに鮭フレーク、刻んだ大葉、いりごまを加えて混ぜ、塩少々で味をととのえる。",
      "en": "Mix the salmon flakes, shredded shiso and sesame into the rice and season with a pinch of salt."
    },
    {
      "ja": "フライパンに油を入れて中火で温め、ソーセージの両面に焼き色をつける。",
      "en": "Heat the oil in a frying pan over medium heat and brown the sausage on both sides."
    },
    {
      "ja": "お弁当箱に混ぜごはんを平らに敷いてソーセージを中心に置き、まわりにコーンを花びらのように並べて、枝豆を添える。",
      "en": "Spread the rice flat in the box, put the sausage in the centre, arrange corn kernels around it like petals and add the edamame."
    }
  ],
  "storage": [
    {
      "ja": "焼いたソーセージは冷ましてから詰め、コーンや枝豆は水気をよくふいてから並べます。",
      "en": "Let the fried sausage cool before packing, and pat the corn and edamame dry before arranging them."
    }
  ],
