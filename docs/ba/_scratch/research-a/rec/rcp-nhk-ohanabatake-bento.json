  "steps": [
    {
      "ja": "そぼろを作る。ひき肉、みそ、砂糖、しょうゆ、小麦粉、みりんと水小さじ1を耐熱ボウルに合わせ、よく混ぜる。",
      "en": "Make the soboro: in a heatproof bowl, mix the mince well with the miso, sugar, soy sauce, flour, mirin and 1 tsp water."
    },
    {
      "ja": "ラップをふんわりかけて500Wのレンジで2分加熱し、すばやく全体を混ぜる。再びラップをして、さらに1分加熱する。",
      "en": "Cover loosely with cling film, microwave at 500 W for 2 minutes and stir quickly. Cover again and microwave for 1 more minute."
    },
    {
      "ja": "卵を溶いて塩少々を加える。サラダ油少々を中火で温めたフライパンを傾け、火の当たる角に卵液を流し、手早く混ぜて細かいいり卵にする。",
      "en": "Beat the egg with a pinch of salt. Heat a little oil in a frying pan over medium heat, tilt the pan so the egg pools in the heated corner, and stir fast into fine scrambled egg."
    },
    {
      "ja": "いり卵をご飯の半分に混ぜる。",
      "en": "Mix the egg into half of the rice."
    },
    {
      "ja": "ブロッコリーの茎を厚さ2mmに切り、花の抜き型で抜いて、塩を入れた湯でさっとゆでる。",
      "en": "Slice the broccoli stem 2 mm thick, cut out flowers with a cutter and blanch them briefly in salted water."
    },
    {
      "ja": "ブロッコリーはやわらかくゆでて水気をよくきり、細かく刻んで、もう半分のご飯に混ぜ込む。ハムも花の型で抜く。",
      "en": "Boil the broccoli floret until soft, drain it well, chop it finely and mix it into the other half of the rice. Cut flowers out of the ham as well."
    },
    {
      "ja": "お弁当箱の底にブロッコリーご飯を入れ、そぼろ、卵ご飯の順に重ねる。最後に、花形のハムと茎の花を上に散らす。",
      "en": "Put the broccoli rice in the bottom of the box, then a layer of soboro, then the egg rice. Decorate with the ham and broccoli-stem flowers."
    }
  ],
  "storage": [
    {
      "ja": "いり卵は半熟を残さず、しっかり固まるまで火を通します。",
      "en": "Cook the scrambled egg until fully set, with no soft parts."
    },
    {
      "ja": "ハムは型で抜いて生のまま飾るレシピです。農林水産省は、そのまま食べられるハムなども、できるだけ加熱して使うようすすめています。",
      "en": "The ham is used raw as a decoration here. Japan's Ministry of Agriculture advises heating even ready-to-eat foods such as ham for bentos where possible."
    },
    {
      "ja": "ゆでたブロッコリーは水気をよくきってから、ご飯に混ぜます。",
      "en": "Drain the boiled broccoli well before mixing it into the rice."
    }
  ],
