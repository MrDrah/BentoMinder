        "role": "Illustration only (decorative, no text on it, exempt from contrast)"
      },
      "illus-brown": {
        "value": "#9A6544",
        "role": "Illustration only (decorative, no text on it, exempt from contrast)"
      },
      "illus-nori": {
        "value": "#1B2A4A",
        "role": "Illustration only (decorative, no text on it, exempt from contrast)"
      },
      "illus-pink": {
        "value": "#F4B6AE",
        "role": "Illustration only (decorative, no text on it, exempt from contrast)"
      }
    },
    "dark": {
      "surface-1": {
        "value": "#141B2B"
      },
      "surface-2": {
        "value": "#1C2539"
      },
      "surface-3": {
        "value": "#253049"
      },
      "line-1": {
        "value": "#2F3A54"
      },
      "line-ui": {
        "value": "#7D7A72"
      },
      "ink-1": {
        "value": "#F6EFE2"
