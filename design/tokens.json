      "warning": {
        "value": "#F2C66D"
      },
      "warning-soft": {
        "value": "#3A3020"
      },
      "danger": {
        "value": "#FF9C92"
      },
      "danger-soft": {
        "value": "#40242A"
      },
      "focus-ring": {
        "value": "#8FB4F0"
      },
      "stripe-a": {
        "value": "#F6EFE2"
      },
      "stripe-b": {
        "value": "#F08A80"
      },
      "scrim": {
        "value": "rgba(0, 0, 0, 0.6)"
      },
      "illus-rice": {
        "value": "#F6EFE2"
      },
      "illus-nori": {
        "value": "#141B2B"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "value": "\"Zen Maru Gothic\", \"Hiragino Maru Gothic ProN\", \"BIZ UDPGothic\", \"Hiragino Sans\", \"Yu Gothic UI\", \"Noto Sans JP\", Meiryo, system-ui, sans-serif",
        "role": "Headings, calendar numerals, buttons, brand"
      },
      "body": {
        "value": "\"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"BIZ UDPGothic\", \"Yu Gothic UI\", \"Noto Sans JP\", Meiryo, system-ui, sans-serif",
        "role": "Running text, lists, inputs (system fonts: zero download)"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "size": {
      "xs": {
        "value": "12px",
        "role": "Calendar cell labels, legend captions. Minimum size for Japanese text"
      },
      "sm": {
        "value": "14px",
        "role": "Secondary text, chips"
      },
      "md": {
        "value": "16px",
        "role": "Body, inputs (prevents iOS zoom)"
      },
      "lg": {
        "value": "18px",
        "role": "Card titles, day sheet date"
      },
      "xl": {
        "value": "22px",
        "role": "Screen titles"
      },
      "2xl": {
        "value": "28px",
        "role": "Today view headline"
      },
      "3xl": {
        "value": "34px",
        "role": "Brand/onboarding hero"
      }
    },
    "line-height": {
      "tight": {
        "value": 1.35,
        "role": "Headings, calendar cells"
      },
      "normal": {
        "value": 1.7,
        "role": "Japanese body text"
      },
      "relaxed": {
        "value": 1.85,
        "role": "Recipe steps"
      }
    },
    "letter-spacing": {
      "body": {
        "value": "0.02em"
      },
      "heading": {
        "value": "0.04em"
      }
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "size": {
    "touch-min": {
      "value": "44px",
      "role": "Minimum hit area for every control"
    },
    "touch-comfy": {
      "value": "52px",
      "role": "Primary CTAs and calendar day cells"
    },
    "cell-min-height": {
      "value": "68px",
      "role": "Calendar day cell height at 360-430px widths"
    },
    "content-max": {
      "value": "480px",
      "role": "Single-column max width on tablet/desktop"
    }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "24px",
    "pill": "999px"
  },
  "elevation": {
    "light": {
      "1": "0 1px 2px rgba(27,42,74,0.06), 0 1px 1px rgba(27,42,74,0.04)",
      "2": "0 4px 12px rgba(27,42,74,0.08), 0 1px 3px rgba(27,42,74,0.06)",
      "3": "0 -8px 28px rgba(27,42,74,0.14)"
    },
    "dark": {
      "1": "0 1px 2px rgba(0,0,0,0.4)",
      "2": "0 4px 12px rgba(0,0,0,0.45)",
      "3": "0 -8px 28px rgba(0,0,0,0.55)"
    }
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    },
    "reduced-motion": "All durations become 0ms; sheets appear without slide; no confetti on confirm"
  },
  "stripe": {
    "band": {
      "value": "repeating-linear-gradient(180deg, var(--stripe-a) 0 3px, transparent 3px 7px)",
      "role": "Decorative horizontal Breton band, max 4 stripes, top of app bar / card edges"
    },
    "hatch": {
      "value": "repeating-linear-gradient(135deg, var(--line-1) 0 2px, transparent 2px 7px)",
      "role": "Functional: no school lunch days. Diagonal so it never reads as decoration"
    }
  },
  "breakpoint": {
    "sm": "360px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  },
  "calendar": {
    "week-start": {
      "value": "monday",
      "role": "Default. Setting allows sunday"
    },
    "weekend-numerals": {
      "value": "saturday blue, sunday/holiday red (numerals and header letters only)"
    }
  }
}
