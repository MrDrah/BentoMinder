{
  "$schema": "BentoMinder design tokens v0.1 (direction preview, 2026-10-24)",
  "$description": "Role-based tokens. The app uses only the CSS custom properties generated from this file (design/tokens.css). Raw hex values in src/ are a review comment.",
  "version": "0.1.0",
  "color": {
    "light": {
      "surface-1": {
        "value": "#FFFFFF",
        "role": "Page background (pure white, PO 2026-10-24)"
      },
      "surface-2": {
        "value": "#FFFDF8",
        "role": "Cards, sheets, calendar school-day cells"
      },
      "surface-3": {
        "value": "#F2EADB",
        "role": "Sunken: weekend cells, inputs read-only, chips"
      },
      "line-1": {
        "value": "#E4DAC8",
        "role": "Decorative hairlines and dividers only (not a UI boundary)"
      },
      "line-ui": {
        "value": "#8C8574",
        "role": "Input and control borders (>= 3:1 on surface-2)"
      },
      "ink-1": {
        "value": "#1B2A4A",
        "role": "Primary text, navy"
      },
      "ink-2": {
        "value": "#3F4B66",
        "role": "Secondary text"
      },
      "ink-3": {
        "value": "#5F6880",
        "role": "Tertiary text, hints, assessment marks"
      },
      "ink-inverse": {
        "value": "#FBF6EC",
        "role": "Text on navy or accent-strong fills"
      },
      "accent": {
        "value": "#D2574F",
        "role": "Soft red: borders, icons, stripes, suggestion outline. Never text, never a fill under text"
      },
      "accent-strong": {
        "value": "#B8443C",
        "role": "Primary CTA fill (with ink-inverse text)"
      },
      "accent-strong-hover": {
        "value": "#A23A33",
        "role": "Primary CTA hover/active"
      },
      "accent-ink": {
        "value": "#A83A33",
        "role": "Red text: Sunday/holiday numerals, links-as-accent"
      },
      "accent-soft": {
        "value": "#F8E1DC",
        "role": "Tint behind low-preference content in sheets"
      },
      "navy-fill": {
        "value": "#1B2A4A",
        "role": "Confirmed homemade bento cell fill"
      },
      "saturday": {
        "value": "#2F5C9A",
        "role": "Saturday numerals"
      },
      "sunday": {
        "value": "#A83A33",
        "role": "Sunday and public-holiday numerals"
      },
      "info": {
        "value": "#2F5C9A",
        "role": "Info icon/text"
      },
      "info-soft": {
        "value": "#E3ECF8",
        "role": "Info banner background (reminder banner)"
      },
      "success": {
        "value": "#2F6B4F",
        "role": "Reservation-done tick, saved confirmations"
      },
      "success-soft": {
        "value": "#E1F0E6",
        "role": "Success banner background"
      },
      "warning": {
        "value": "#7A4E00",
        "role": "Warning text: outdated menu, unknown allergen"
      },
      "warning-soft": {
        "value": "#FFF0D1",
        "role": "Warning banner background"
      },
      "danger": {
        "value": "#A3271F",
        "role": "Error text and destructive actions"
      },
      "danger-soft": {
        "value": "#FBE3E0",
        "role": "Error banner background"
      },
      "focus-ring": {
        "value": "#1F5FBF",
        "role": "2px focus outline with 2px surface offset"
      },
      "stripe-a": {
        "value": "#1B2A4A",
        "role": "Decorative stripe colour (navy)"
      },
      "stripe-b": {
        "value": "#D2574F",
        "role": "Decorative stripe colour (soft red)"
      },
      "scrim": {
        "value": "rgba(27, 42, 74, 0.45)",
        "role": "Behind bottom sheets and dialogs"
      },
      "illus-rice": {
        "value": "#FFFFFF",
        "role": "Illustration only (decorative, no text on it, exempt from contrast)"
      },
      "illus-egg": {
        "value": "#F2C14E",
        "role": "Illustration only (decorative, no text on it, exempt from contrast)"
      },
      "illus-green": {
