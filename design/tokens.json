      "ink-3": {
        "value": "#A7A398"
      },
      "ink-inverse": {
        "value": "#141B2B"
      },
      "accent": {
        "value": "#F08A80"
      },
      "accent-strong": {
        "value": "#F08A80"
      },
      "accent-strong-hover": {
        "value": "#F4A097"
      },
      "accent-ink": {
        "value": "#F4A097"
      },
      "accent-soft": {
        "value": "#3A2429"
      },
      "navy-fill": {
        "value": "#F6EFE2",
        "role": "Inverted: confirmed bento is a cream solid with navy text in dark mode"
      },
      "saturday": {
        "value": "#8FB4F0"
      },
      "sunday": {
        "value": "#F4A097"
      },
      "info": {
        "value": "#8FB4F0"
      },
      "info-soft": {
        "value": "#22314F"
      },
      "success": {
        "value": "#8FD3AE"
      },
      "success-soft": {
        "value": "#1D3A30"
