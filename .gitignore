# local Claude Code settings (personal, not shared)
.claude/settings.local.json
# task baselines (validate.mjs task-start) and framework upgrade backups
.claude/state/
.claude/.upgrade-backup/

# agent worktrees (Claude Code Agent isolation)
.claude/worktrees/

# research scratch: saved source pages (copyrighted, never committed; the overlap cache is .cache/)
docs/ba/_scratch/**/*.html

# real school documents used as local mocks; never commit (public repo)
local-mocks/

# Playwright run artifacts of the QA suites
tests/_scratch/qa-*-results/

# hosted function (ADR 015): bundle is generated, settings files carry deployment values
functions/lib/
functions/node_modules/
functions/.env.*
!functions/.env.example
.firebase/
firebase-debug.log
firestore-debug.log

