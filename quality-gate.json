{
  "$comment": "app-boilerplate quality gate config. Used by .claude/skills/quality-gate/scripts/validate.mjs, the guard hook and CI.",
  "commands": [
    {
      "name": "validate data",
      "run": "npm run validate:data"
    },
    {
      "name": "fixture conventions",
      "run": "npm run check:fixtures"
    },
    {
      "name": "lint",
      "run": "npm run lint"
    },
    {
      "name": "typecheck",
      "run": "npm run typecheck"
    },
    {
      "name": "unit + coverage",
      "run": "npm run coverage"
    },
    {
      "name": "build",
      "run": "npm run build"
    },
    {
      "name": "no debug in build",
      "run": "npm run check:no-debug"
    },
    {
      "name": "e2e",
      "run": "npm run test:e2e"
    }
  ],
  "generated": [
    {
      "path": "dist/**",
      "by": "npm run build"
    },
    {
      "path": "data/library.json",
      "from": "data/_research/batch-*.json",
      "by": "npm run merge:research"
    },
    {
      "path": "data/dictionary.json",
      "from": "docs/ba/domain-dictionary.md",
      "by": "npm run build:dictionary"
    },
    {
      "path": "coverage/**",
      "by": "npm run coverage"
    },
    {
      "path": "reports/**",
      "by": "npm run coverage, npm run test:e2e, npm run eval:extraction"
    },
    {
      "path": "tests/fixtures/menus/*/menu.pdf",
      "from": "tests/fixtures/menus/*/layout.html",
      "by": "npm run fixtures:menus (Windows: uses installed Japanese fonts)"
    },
    {
      "path": "tests/fixtures/pdf/not-a-pdf.pdf",
      "by": "npm run fixtures:menus"
    }
  ],
  "docs": {
    "required": [
      "CATCH-UP.md",
      "docs/PLAN.md",
      "docs/PROJECT_BRIEF.md",
      "docs/ba/user-stories.md",
      "docs/ba/data-contract.md",
      "docs/dev/architecture.md",
      "data/banned-phrases.json"
    ],
    "catchUp": "CATCH-UP.md",
    "maxStaleDays": 7,
    "decisionLog": {
      "file": "docs/PLAN.md",
      "heading": "Decision"
    }
  },
  "trace": {
    "stories": "docs/ba/user-stories.md",
    "tests": [
      "tests/**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}",
      "src/**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}"
    ],
    "pattern": "US-[A-Z0-9]+-\\d+",
    "allowUntested": [
      "US-E7-08",
      "US-E12-02",
      "US-E12-03",
      "US-E12-04",
      "US-E12-01",
      "US-E8-04"
    ]
  },
  "stages": {
    "dev": [
      "preflight",
      "secrets",
      "commands",
      "budget"
    ],
    "release": [
      "preflight",
      "docs",
      "trace",
      "secrets",
      "commands",
      "budget",
      "overlap",
      "evidence"
    ]
  },
  "budgets": [
    {
      "name": "JS bundle",
      "glob": "dist/assets/*.js",
      "maxGzipKb": 400
    },
    {
      "name": "CSS",
      "glob": "dist/assets/*.css",
      "maxGzipKb": 50
    },
    {
      "name": "Recipe library",
      "glob": "data/library.json",
      "maxGzipKb": 60
    }
  ],
  "secrets": {
    "exclude": [
      "package-lock.json",
      "**/*.lock",
      "**/*.min.js"
    ]
  },
  "overlap": {
    "records": [
      "data/_research/batch-*.json"
    ],
    "idField": "id",
    "fields": [
      "description.en",
      "steps.0.en",
      "steps.1.en",
      "steps.2.en",
      "steps.3.en",
      "steps.4.en",
      "steps.5.en",
      "steps.6.en",
      "steps.7.en",
      "steps.8.en",
      "steps.9.en",
      "steps.10.en",
      "steps.11.en",
      "storage.0.en",
      "storage.1.en",
      "storage.2.en",
      "storage.3.en",
      "adaptations.0.en",
      "adaptations.1.en",
      "adaptations.2.en",
      "adaptations.3.en",
      "makeAhead.en"
    ],
    "sourcesField": "sources",
    "urlField": "url",
    "cacheDir": ".cache/sources",
    "minRun": 7,
    "failAt": 12,
    "acceptFile": "data/_research/overlap-accepted.json",
    "delayMs": 3000,
    "inGate": true
  },
  "preflight": {
    "nodeMajor": 22,
    "requireRemote": false,
    "optional": [
      "gh",
      "playwright"
    ]
  },
  "evidence": {
    "$comment": "Milestone evidence packages (milestone-evidence skill). Milestone ids are yours to choose; liveUrl and smokeMarker enable the live check. billingModel: api, subscription, mixed or unknown. pricing (optional): list prices per model in USD per million tokens, e.g. { <model>: { inputPerMTok, outputPerMTok, cacheWritePerMTok, cacheReadPerMTok, source: <pricing page URL> } }. Without pricing, tokens are measured and cost stays unavailable.",
    "project": {
      "id": "bentominder",
      "name": "BentoMinder",
      "repository": null
    },
    "milestones": [
      {
        "id": "mvp",
        "label": "MVP"
      },
      {
        "id": "beta-0.5",
        "label": "Beta 0.5"
      },
      {
        "id": "release-1.0",
        "label": "Version 1.0"
      }
    ],
    "events": "docs/evidence/events.jsonl",
    "testResults": [
      "reports/junit*.xml"
    ],
    "testCommand": "npx vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "coverageSummary": "coverage/coverage-summary.json",
    "billingModel": "subscription",
    "usageLog": "docs/evidence/usage.jsonl",
    "pricing": null,
    "liveUrl": "https://mrdrah.github.io/BentoMinder/",
    "smokeMarker": "BentoMinder"
  }
}
